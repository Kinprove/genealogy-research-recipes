{
  "name": "@kinprove/genealogy-research-recipes",
  "version": "1.17.2",
  "private": false,
  "description": "Fact-checked genealogy recipes for DNA evidence, record searches and proof judgment.",
  "license": "FSL-1.1-MIT AND LicenseRef-Third-Party-Content",
  "author": {
    "name": "Kinprove",
    "email": "hola@kinprove.io"
  },
  "homepage": "https://github.com/Kinprove/genealogy-research-recipes",
  "keywords": ["genealogy", "family-history", "dna", "genetic-genealogy", "records", "jewish-genealogy"],
  "repository": {
    "type": "git",
    "url": "https://github.com/Kinprove/genealogy-research-recipes.git"
  },
  "type": "module",
  "peerDependencies": {
    "openclaw": ">=2026.9.8"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "files": [
    "index.js",
    "openclaw.plugin.json",
    "NOTICE",
    "skills/genealogy-research-recipes/SKILL.md",
    "skills/genealogy-research-recipes/CHANGELOG.md",
    "skills/genealogy-research-recipes/LICENSE",
    "skills/genealogy-research-recipes/NOTICE",
    "skills/genealogy-research-recipes/recipes/**/*.md",
    "skills/genealogy-research-recipes/sources/**/*.md",
    "skills/genealogy-research-recipes/scripts/**/*.py",
    "skills/genealogy-research-recipes/resources/**/*.json"
  ],
  "openclaw": {
    "extensions": ["./index.js"],
    "compat": {
      "pluginApi": ">=2026.9.8"
    },
    "build": {
      "openclawVersion": "2026.9.8"
    }
  }
}
